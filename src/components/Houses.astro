---
import Leaf from './Leaf.astro';

// Order as listed by the school; colours as on the house flags.
const houses = [
  { name: 'Neem', colour: 'Green', leaf: 'text-neem', bar: 'bg-neem' },
  { name: 'Peepal', colour: 'Yellow', leaf: 'text-peepal', bar: 'bg-peepal' },
  { name: 'Gulmohar', colour: 'Red', leaf: 'text-gulmohar', bar: 'bg-gulmohar' },
  { name: 'Tulsi', colour: 'Blue', leaf: 'text-tulsi', bar: 'bg-tulsi' },
];
---

<ul class="grid grid-cols-2 gap-4 md:grid-cols-4">
  {
    houses.map((house) => (
      <li class="relative overflow-hidden rounded-2xl border border-line bg-paper p-5 shadow-[var(--shadow-card)]">
        <span class:list={['absolute inset-x-0 top-0 h-1.5', house.bar]} />
        <Leaf class={`h-12 w-auto ${house.leaf}`} />
        <p class="mt-3 font-display text-2xl font-semibold text-forest-900">{house.name}</p>
        <p class="text-sm text-muted">House colour: {house.colour}</p>
      </li>
    ))
  }
</ul>
