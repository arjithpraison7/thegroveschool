---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, fullAddress } from '../data/site';
import { url, isLiveSite } from '../lib/url';

interface Props {
  /** Page title; " · The Grove School" is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Structured data (schema.org) to embed on this page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, jsonLd } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ICSE & ISC School in Alwarpet, Chennai`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og-image.jpg'), Astro.site);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!isLiveSite && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#132e1d" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={url('/icon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="address" content={fullAddress} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-[60] rounded-full bg-forest-900 px-5 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    {
      !isLiveSite && (
        <p class="bg-saffron-500 px-4 py-1.5 text-center text-sm font-semibold text-forest-950">
          Preview for review: this is not the live school website yet.
        </p>
      )
    }
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
