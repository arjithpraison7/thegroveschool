---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Leaf from '../components/Leaf.astro';
import { nav } from '../data/site';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="relative overflow-hidden bg-leaf-50">
    <Leaf class="pointer-events-none absolute -top-10 right-[10%] w-48 rotate-[20deg] text-leaf-200/70" />
    <div class="container-page relative py-24 md:py-32">
      <p class="eyebrow">Error 404</p>
      <h1 class="mt-3 text-5xl font-semibold sm:text-6xl">This page has wandered off.</h1>
      <p class="mt-5 max-w-xl text-lg text-muted">
        The page may have moved when the website was redesigned. Try one of these instead:
      </p>
      <ul class="mt-8 flex flex-wrap gap-3">
        <li><a href={url('/')} class="btn btn-green">Home <ArrowRight size={17} aria-hidden="true" /></a></li>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} class="btn btn-outline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
