---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Leaf from './Leaf.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  /** Breadcrumb trail between "Home" and the current page. */
  crumbs?: { label: string; href: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, eyebrow, intro, crumbs = [], image, imageAlt = '' } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line bg-leaf-50">
  <Leaf class="pointer-events-none absolute -top-12 right-[6%] w-44 rotate-[18deg] text-leaf-200/70" />
  <Leaf class="pointer-events-none absolute -bottom-16 right-[30%] w-24 -rotate-[28deg] text-leaf-200/60" />
  <div class:list={['container-page relative grid items-center gap-10 py-12 md:py-16', image && 'lg:grid-cols-[1.1fr_1fr] lg:gap-14']}>
    <div>
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li><a href={url('/')} class="hover:text-leaf-800 hover:underline">Home</a></li>
          {
            crumbs.map((crumb) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true">/</span>
                <a href={url(crumb.href)} class="hover:text-leaf-800 hover:underline">
                  {crumb.label}
                </a>
              </li>
            ))
          }
          <li class="flex items-center gap-2">
            <span aria-hidden="true">/</span>
            <span aria-current="page" class="font-semibold text-forest-900">{title}</span>
          </li>
        </ol>
      </nav>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-2 text-4xl font-semibold sm:text-5xl">{title}</h1>
      {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="relative mx-2 sm:mx-6 lg:mx-0">
          <div class="absolute -inset-2.5 rotate-[2.5deg] rounded-[2rem] bg-saffron-200/70" aria-hidden="true" />
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 720, 960, 1200]}
            width={Math.min(1200, image.width)}
            sizes="(min-width: 76rem) 34rem, (min-width: 64rem) 44vw, 92vw"
            class="relative aspect-[4/3] w-full rounded-[1.75rem] object-cover shadow-[var(--shadow-lift)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>
